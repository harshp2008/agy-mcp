# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
.venv/
venv/
ENV/

# Tool caches
.ruff_cache/
.pytest_cache/

# Coverage output (audit G7)
.coverage
htmlcov/

# pytest --basetemp scratch dirs. They were ignored only through the uncommitted
# .git/info/exclude, so a fresh clone (or an agy worktree) saw them as untracked
# (audit A6/G7).
.pytest-basetemp*/

# Per-job scratchpad directory created inside an agy worktree (.agy/REPORT.md,
# PLAN.md, NOTES.md, LOG.md); never tracked (audit G7).
.agy/
