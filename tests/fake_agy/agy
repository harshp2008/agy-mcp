def write_usage_auth_line(log_file: str | None) -> None:
    log_entry(
        log_file,
        f"applyAuthResult: email={_fake_usage_email()}, authMethod=consumer",
    )


def load_home_usage_payload() -> dict | None:
    """Load a full /usage payload from $HOME/.fake_agy_usage.json when present.

    This is how a test gives two account HOMEs different quota values; the fixed
    scenarios above remain the default when no payload file exists.
    """
    home = os.environ.get("HOME")
    if not home:
        return None
    marker = Path(home) / ".fake_agy_usage.json"
    if not marker.is_file():
        return None
    try:
        data = json.loads(marker.read_text(encoding="utf-8"))
    except Exception:
        return None
    return data if isinstance(data, dict) else None


def load_home_models() -> list[str] | None:
    """Load a per-HOME accepted-model list from $HOME/.fake_agy_models."""
    home = os.environ.get("HOME")
    if not home:
        return None
    marker = Path(home) / ".fake_agy_models"
    if not marker.is_file():
        return None
    try:
        data = json.loads(marker.read_text(encoding="utf-8"))
    except Exception:
        return None
    if not isinstance(data, list) or not all(isinstance(item, str) for item in data):
        return None
    return data


def render_usage_payload(scenario: str) -> dict:
    """Return the fixture payload, optionally zeroed/low for scenario variants."""
    payload = load_usage_fixture()
    variants = ("usage_zero", "usage_low", "usage_zero_claude")
    if scenario not in variants:
        return payload

    claude_only = scenario == "usage_zero_claude"
    fraction = 0.0 if scenario in ("usage_zero", "usage_zero_claude") else 0.05
    percent = "0%" if scenario in ("usage_zero", "usage_zero_claude") else "5%"

    def targeted(group_name: str) -> bool:
        if not claude_only:
            return True
        return "claude" in group_name.lower()

    for group in payload.get("command", {}).get("data", {}).get("groups", []):
        if not targeted(str(group.get("name", ""))):
            continue
        for bucket in group.get("buckets", []):
            bucket["remaining_fraction"] = fraction
    lines = []
    for line in payload.get("response", "").splitlines():
        if not line.strip():
            continue
        parts = line.split("\t")
        if len(parts) == 4 and targeted(parts[0]):
            parts[2] = percent
        lines.append("\t".join(parts))
    payload["response"] = "\n".join(lines) + "\n"
    return payload


def handle_usage(log_file: str | None) -> None:
    """Simulate `agy --output-format json -p "/usage"`."""
    scenario = detect_usage_scenario()

    if scenario == "usage_auth_required":
        sys.stderr.write(
            "Error: not logged in to agy. Run `agy login` to continue.\n"
        )
        sys.exit(1)

    if scenario == "usage_hang":
        while True:
            time.sleep(1.0)

    write_usage_auth_line(log_file)

    if scenario == "usage_empty":
        sys.exit(0)

    if scenario == "usage_garbled":
        print(
            json.dumps(
                {
                    "status": "SUCCESS",
                    "response": "garbled usage output that is not a table",
                    "command": {"data": {}},
                }
            )
        )
        sys.exit(0)

    payload = load_home_usage_payload()
    if payload is not None:
        print(json.dumps(payload))
        sys.exit(0)

    print(json.dumps(render_usage_payload(scenario)))
    sys.exit(0)


def main() -> None:
    record_file = None
    if "FAKE_AGY_RECORD" in os.environ:
        record_file = Path(os.environ["FAKE_AGY_RECORD"])
    elif "TMPDIR" in os.environ and (Path(os.environ["TMPDIR"]) / ".fake_agy_record").is_file():
        try:
            ptr = Path(os.environ["TMPDIR"]) / ".fake_agy_record"
            record_file = Path(ptr.read_text().strip())
        except Exception:
            pass
    elif "HOME" in os.environ and (Path(os.environ["HOME"]) / ".fake_agy_record").is_file():
        try:
            ptr = Path(os.environ["HOME"]) / ".fake_agy_record"
            record_file = Path(ptr.read_text().strip())
        except Exception:
            pass

    if record_file:
        try:
            if "/usage" in sys.argv:
                # Keep /usage records in a sidecar so job argv recordings are unchanged.
                target = Path(str(record_file) + ".usage")
                entry = {"argv": sys.argv, "cwd": os.getcwd()}
            else:
                target = record_file
                entry = sys.argv
            target.parent.mkdir(parents=True, exist_ok=True)
            with target.open("a", encoding="utf-8") as rf:
                rf.write(json.dumps(entry) + "\n")
        except Exception:
            pass

    _write_env_probe()
    args = parse_args(sys.argv[1:])
    prompt = str(args.get("prompt", ""))
    log_file = str(args["log_file"]) if args.get("log_file") else None
    conversation_id = str(args["conversation"]) if args.get("conversation") else None

    requested_model = str(args["model"]) if args.get("model") else None
    if requested_model and prompt != "/usage":
        accepted_models = load_home_models()
        if accepted_models is not None and requested_model not in accepted_models:
            sys.stderr.write(
                "error: invalid model selection (--model "
                f'"{requested_model}" --effort ""): model {requested_model} is not '
                "recognized as a known model or custom model in settings\n"
            )
            sys.exit(1)

    if prompt == "/usage":
        handle_usage(log_file)

    # agy is not known to append or truncate a reused --log-file on resume.
    # Default keeps the historical append behavior; tests can switch to
    # truncate with FAKE_AGY_CLI_LOG_MODE / <jobdir>/.fake_agy_cli_log_mode.
    cli_log_mode = _fake_setting(
        log_file, "FAKE_AGY_CLI_LOG_MODE", ".fake_agy_cli_log_mode"
    ).lower()
    if cli_log_mode == "truncate" and log_file:
        try:
            Path(log_file).write_text("", encoding="utf-8")
        except Exception:
            pass

    log_entry(log_file, "Starting fake agy session")
    # Real agy logs "Created conversation <uuid>" at startup and
    # "Print mode: resuming conversation <uuid>" after --conversation. Both are
    # strict-UUID sources for the wrapper; a fresh run gets a deterministic UUID
    # derived from the job log path so tests stay reproducible. A test can force
    # a distinct UUID for a later fresh generation (or make agy ignore the
    # requested conversation) through a job-dir marker / env knob.
    ignore_conversation = _fake_setting(
        log_file, "FAKE_AGY_IGNORE_CONVERSATION", ".fake_agy_ignore_conversation"
    ).lower() not in ("", "0", "false", "no")
    if ignore_conversation:
        conversation_id = None
    resumed = conversation_id is not None
    fresh_seed = _fake_setting(
        log_file, "FAKE_AGY_FRESH_UUID_SEED", ".fake_agy_fresh_uuid_seed"
    )
    if resumed and conversation_id is not None and _conversation_store_enabled():
        db_path = _conversation_db_path(conversation_id)
        if db_path is not None and not db_path.is_file():
            # Mirror the real CLI: warn and silently start a NEW conversation.
            sys.stderr.write(f'warning: conversation "{conversation_id}" not found\n')
            conversation_id = None
            resumed = False
    if resumed and conversation_id is not None:
        log_entry(log_file, f"Print mode: resuming conversation {conversation_id}")
    else:
        seed = "fake-agy:" + str(log_file or os.getcwd())
        if fresh_seed:
            seed += "|" + fresh_seed
        if ignore_conversation:
            seed += "|ignored"
        conversation_id = str(uuid.uuid5(uuid.NAMESPACE_URL, seed))
        log_entry(log_file, f"Created conversation {conversation_id}")
    _write_conversation_db(conversation_id)
    scenario = detect_scenario(prompt, log_file)
    log_entry(log_file, f"Detected simulation scenario: {scenario}")

    global _SKIP_AUTO_SCRATCHPAD
    if scenario in _MANUAL_SCRATCHPAD_SCENARIOS:
        _SKIP_AUTO_SCRATCHPAD = True

    if "TRIGGER_AUTOFIX_CREATE_FIXED" in prompt:
        Path("fixed.txt").write_text("fixed\n")

    if scenario == "success_model_alias":
        # Exact masked cli.log line from the real smoke evidence (JOB 1 line
        # 152 / JOB 2 line 128): the unqualified alias is silently resolved.
        log_entry(
            log_file,
            'model_resolver.go:155] model alias "gemini-3.8-flash" '
            'resolved to "gemini-3.8-flash-high"',
        )
        output = {
            "conversation_id": conversation_id,
            "status": "SUCCESS",
            "response": "Task completed after the CLI resolved the model alias.",
            "usage": {
                "input_tokens": 100,
                "output_tokens": 50,
                "total_tokens": 150,
            },
        }
        print(json.dumps(output))
        sys.exit(0)

    if scenario == "success_simple":
        log_entry(log_file, "Executing step 1/1")
        log_entry(log_file, "Step 1 finished successfully")
        output = {
            "conversation_id": conversation_id,
            "status": "SUCCESS",
            "response": "Task completed successfully without warnings.",
            "usage": {
                "input_tokens": 100,
                "output_tokens": 50,
                "total_tokens": 150,
            },
        }
        print(json.dumps(output))
        sys.exit(0)

    elif scenario == "success_with_commits":
        log_entry(log_file, "Creating worktree files")
        # Write a file
