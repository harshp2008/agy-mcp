    # every PLAN box is ticked and REPORT.md gets a verification note. Scenarios
    # in _MANUAL_SCRATCHPAD_SCENARIOS opt out.
    _real_exit = sys.exit

    def _exit_with_scratchpad(code=0):
        if not code:
            _complete_scratchpad()
        _real_exit(code)

    sys.exit = _exit_with_scratchpad
    main()
