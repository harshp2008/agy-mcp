#!/usr/bin/env python3
"""Fake agy executable for testing agy-mcp without invoking real Gemini API."""

import json
import os
import re
import select
import signal
import subprocess
import sys
import time
import uuid
from pathlib import Path

# Early signal ignore if requested to avoid race condition during startup.
# The readiness marker is written only after the handler is installed, so a
# test can signal the process group without racing the exec/handler window.
if any("hang_ignore_sigterm" in a for a in sys.argv):
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    try:
        ready_dir = os.environ.get("TMPDIR")
        if ready_dir:
            (Path(ready_dir) / ".fake_agy_sigterm_ready").write_text(
                "ready", encoding="utf-8"
            )
    except Exception:
        pass


def parse_args(argv: list[str]) -> dict[str, object]:
    """Parse agy CLI arguments strictly. Flags must precede -p <prompt>."""
    parsed: dict[str, object] = {
        "mode": None,
        "output_format": None,
        "print_timeout": None,
        "log_file": None,
        "model": None,
        "conversation": None,
        "prompt": None,
    }

    i = 0
    p_encountered = False
    while i < len(argv):
        arg = argv[i]
        if p_encountered:
            sys.stderr.write(f"Error: unexpected argument after prompt: {arg}\n")
            sys.exit(1)

        if arg == "-p" or arg == "--prompt":
            p_encountered = True
            if i + 1 >= len(argv):
                sys.stderr.write("Error: -p requires an argument\n")
                sys.exit(1)
            prompt_val = argv[i + 1]
            if not prompt_val:
                sys.stderr.write("Error: prompt cannot be empty string\n")
                sys.exit(1)
            parsed["prompt"] = prompt_val
            i += 2
            if i < len(argv):
                sys.stderr.write(f"Error: unexpected argument after prompt: {argv[i]}\n")
                sys.exit(1)
            break
        elif arg == "--mode":
            if i + 1 < len(argv):
                val = argv[i + 1]
                if val != "accept-edits":
                    sys.stderr.write(
                        f"Error: unrecognized --mode value \"{val}\" (fake agy requires accept-edits)\n"
                    )
                    sys.exit(1)
                parsed["mode"] = val
                i += 2
            else:
                sys.stderr.write("Error: --mode requires an argument\n")
                sys.exit(1)
        elif arg == "--output-format":
            if i + 1 < len(argv):
                val = argv[i + 1]
                if val != "json":
                    sys.stderr.write(
                        f"Error: unrecognized --output-format value \"{val}\" (fake agy requires json)\n"
                    )
                    sys.exit(1)
                parsed["output_format"] = val
                i += 2
            else:
                sys.stderr.write("Error: --output-format requires an argument\n")
                sys.exit(1)
        elif arg == "--print-timeout":
            if i + 1 < len(argv):
                val = argv[i + 1]
                if not re.match(r"^[0-9]+[smh]$", val):
                    sys.stderr.write(
                        f"Error: invalid --print-timeout value \"{val}\" (must match ^[0-9]+[smh]$)\n"
                    )
                    sys.exit(1)
                parsed["print_timeout"] = val
                i += 2
            else:
                sys.stderr.write("Error: --print-timeout requires an argument\n")
                sys.exit(1)
        elif arg == "--log-file":
            if i + 1 < len(argv):
                val = argv[i + 1]
                if not os.path.isabs(val):
                    sys.stderr.write(
                        f"Error: --log-file must be an absolute path, got: {val}\n"
                    )
                    sys.exit(1)
                parsed["log_file"] = val
                i += 2
            else:
                sys.stderr.write("Error: --log-file requires an argument\n")
                sys.exit(1)
        elif arg == "--model":
            if i + 1 < len(argv):
                parsed["model"] = argv[i + 1]
                i += 2
            else:
                sys.stderr.write("Error: --model requires an argument\n")
                sys.exit(1)
        elif arg == "--conversation":
            if i + 1 < len(argv):
                parsed["conversation"] = argv[i + 1]
                i += 2
            else:
                sys.stderr.write("Error: --conversation requires an argument\n")
                sys.exit(1)
        elif arg == "--effort":
            sys.stderr.write(
                "Error: --effort flag is not supported by agy; pass model with effort\n"
            )
            sys.exit(1)
        elif arg.startswith("-"):
            sys.stderr.write(f"Error: unknown option: {arg}\n")
            sys.exit(1)
        else:
            sys.stderr.write(f"Error: unexpected positional argument: {arg}\n")
            sys.exit(1)

    # /usage mode only needs --output-format json and an absolute --log-file.
    if parsed["prompt"] == "/usage":
        if parsed["output_format"] is None:
            sys.stderr.write("Error: --output-format is required\n")
            sys.exit(1)
        return parsed

    # Post-validation: ensure required flags are present
    if parsed["prompt"] is None:
        sys.stderr.write("Error: -p <prompt> is required and was not provided\n")
        sys.exit(1)
    if parsed["mode"] is None:
        sys.stderr.write("Error: --mode is required\n")
        sys.exit(1)
    if parsed["output_format"] is None:
        sys.stderr.write("Error: --output-format is required\n")
        sys.exit(1)
    if parsed["print_timeout"] is None:
        sys.stderr.write("Error: --print-timeout is required\n")
        sys.exit(1)
    if parsed["log_file"] is None:
        sys.stderr.write("Error: --log-file is required\n")
        sys.exit(1)
    if parsed["model"] is None:
        sys.stderr.write("Error: --model is required\n")
        sys.exit(1)

    return parsed


def detect_scenario(prompt: str, log_file: str | None = None) -> str:
    """Detect the simulation scenario from env, prompt markers, or job-dir state."""
    # 1. Environment variable
    if "FAKE_AGY_SCENARIO" in os.environ:
        return os.environ["FAKE_AGY_SCENARIO"].strip()

    # 2. Marker in prompt (highest priority)
    match = re.search(r"__SCENARIO:([a-zA-Z0-9_-]+)__", prompt)
    if match:
        sc = match.group(1)
        if log_file:
            try:
                (Path(log_file).parent / ".fake_agy_scenario").write_text(sc, encoding="utf-8")
            except Exception:
                pass
        return sc

    match2 = re.search(r"SCENARIO:\s*([a-zA-Z0-9_-]+)", prompt)
    if match2:
        sc = match2.group(1)
        if log_file:
            try:
                (Path(log_file).parent / ".fake_agy_scenario").write_text(sc, encoding="utf-8")
            except Exception:
                pass
        return sc

    # 3. File in cwd
    file_cwd = Path(".fake_agy_scenario")
    if file_cwd.is_file():
        try:
            return file_cwd.read_text(encoding="utf-8").strip()
        except Exception:
            pass

    # 4. Job-dir persistent state across turns
    if log_file:
        file_job = Path(log_file).parent / ".fake_agy_scenario"
        if file_job.is_file():
            try:
                return file_job.read_text(encoding="utf-8").strip()
            except Exception:
                pass

    return "success_simple"


def _fake_setting(log_file_path: str | None, env_name: str, marker_name: str) -> str:
    """Read a fake-agy knob from an env var, then a job-dir marker file.

    The manager's sanitized child env does not forward arbitrary FAKE_* vars, so
    integration tests switch behavior through ``<jobdir>/<marker_name>``; direct
    unit invocations can use the env var.
    """
    value = os.environ.get(env_name, "").strip()
    if value:
        return value
    if log_file_path:
        marker = Path(log_file_path).parent / marker_name
        if marker.is_file():
            try:
                return marker.read_text(encoding="utf-8").strip()
            except Exception:
                pass
    return ""


def log_entry(log_file_path: str | None, message: str) -> None:
    """Write an entry to the CLI log file in agy's real glog header shape.

    Real lines look like ``I1025 12:03:54.313882       1 server.go:1225] ...``;
    the wrapper anchors its conversation-id regexes to this header so agent
    text cannot impersonate a conversation line.
    """
    if not log_file_path:
        return
    try:
        p = Path(log_file_path)
        p.parent.mkdir(parents=True, exist_ok=True)
        now = time.time()
        micros = int((now % 1) * 1_000_000)
        stamp = time.strftime("%m%d %H:%M:%S", time.gmtime(now)) + f".{micros:06d}"
        if "Created conversation" in message:
            source = "server.go:1225"
        elif "resuming conversation" in message:
            source = "session.go:156"
        else:
            source = "fake.go:1"
        with open(p, "a", encoding="utf-8") as f:
            f.write(f"I{stamp}       1 {source}] {message}\n")
    except Exception:
        pass


# Scenarios that manage .agy/PLAN.md and .agy/REPORT.md themselves. The
# default success path ticks every plan box and fills REPORT.md, imitating an
# agent that follows the preamble; these scenarios opt out so tests can
# exercise incomplete plans and dishonest reports.
_MANUAL_SCRATCHPAD_SCENARIOS = {
    "plan_complete",
    "plan_partial",
    "plan_nudge_complete",
    "plan_nudge_partial",
    "report_claim",
    "report_clean",
    "scratchpad_symlink",
}
_SKIP_AUTO_SCRATCHPAD = False


def write_plan(total: int, ticked: int) -> None:
    """Write a deterministic PLAN.md with ``total`` boxes, ``ticked`` done."""
    agy_dir = Path(".agy")
    agy_dir.mkdir(parents=True, exist_ok=True)
    lines = ["# Plan: fake scenario", ""]
    for index in range(1, total + 1):
        box = "x" if index <= ticked else " "
        lines.append(f"- [{box}] {index}. Fake step {index}")
    (agy_dir / "PLAN.md").write_text("\n".join(lines) + "\n", encoding="utf-8")


def write_report(tests_passed_claim: bool) -> None:
    """Write a REPORT.md, optionally containing an unverified test claim."""
    agy_dir = Path(".agy")
    agy_dir.mkdir(parents=True, exist_ok=True)
    how = (
        "All tests passed."
        if tests_passed_claim
        else "Manual review only; agy did not run tests."
    )
    (agy_dir / "REPORT.md").write_text(
        "# REPORT\n\n## Done\nfake work\n\n## Not done / skipped\nnone\n\n"
        "## Open issues\nnone\n\n## Files changed\nnone\n\n"
        f"## How verified\n{how}\n",
        encoding="utf-8",
    )


def _complete_scratchpad() -> None:
    """Imitate a compliant agent on normal exit: tick the plan and fill the report."""
    if _SKIP_AUTO_SCRATCHPAD:
        return
    agy_dir = Path(".agy")
    if not agy_dir.is_dir():
        return
    try:
        plan = agy_dir / "PLAN.md"
        if plan.is_file():
            text = plan.read_text(encoding="utf-8")
            text = re.sub(r"^(\s*[-*+]\s*)\[ \]", r"\1[x]", text, flags=re.MULTILINE)
            plan.write_text(text, encoding="utf-8")
        report = agy_dir / "REPORT.md"
        if report.is_file():
            text = report.read_text(encoding="utf-8")
            text = text.replace(
                "## How verified\n",
                "## How verified\nWrapper runs verification; agy did not run tests.\n",
                1,
            )
            report.write_text(text, encoding="utf-8")
    except Exception:
        pass


# Synthetic test account, assembled from parts so no unmasked address literal
# appears in the repository.
_USAGE_EMAIL_LOCAL = "fake" + ".quota"
_USAGE_EMAIL_DOMAIN = "example" + ".invalid"


def load_usage_fixture() -> dict:
    """Load the committed real /usage fixture."""
    fixture = Path(__file__).resolve().parent.parent / "fixtures" / "real_usage.json"
    return json.loads(fixture.read_text(encoding="utf-8"))


def detect_usage_scenario() -> str:
    """Select a /usage scenario via env var or $HOME/.fake_agy_usage_scenario."""
    env_scenario = os.environ.get("FAKE_AGY_SCENARIO", "").strip()
    if env_scenario:
        return env_scenario
    home = os.environ.get("HOME")
    if home:
        marker = Path(home) / ".fake_agy_usage_scenario"
        if marker.is_file():
            try:
                value = marker.read_text(encoding="utf-8").strip()
                if value:
                    return value
            except Exception:
                pass
    return "usage_real"


CONVERSATIONS_REL = Path(".gemini") / "antigravity-cli" / "conversations"


def _conversation_store_enabled() -> bool:
    """True when the HOME opts into the fake conversation-store behaviour.

    Disabled by default so the pre-existing resume-echo tests keep their old
    contract; a multi-account test enables it by touching
    ``$HOME/.fake_agy_conversation_store``.
    """
    home = os.environ.get("HOME")
    return bool(home) and (Path(home) / ".fake_agy_conversation_store").is_file()


def _conversation_db_path(conversation_id: str) -> Path | None:
    home = os.environ.get("HOME")
    if not home:
        return None
    return Path(home) / CONVERSATIONS_REL / f"{conversation_id}.db"


def _write_conversation_db(conversation_id: str) -> None:
    """Create a SQLite-header conversation file for this HOME (fake, not a real DB)."""
    if not _conversation_store_enabled():
        return
    path = _conversation_db_path(conversation_id)
    if path is None or path.is_file():
        return
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        os.chmod(path.parent, 0o700)
        corrupt = (Path(os.environ["HOME"]) / ".fake_agy_corrupt_conversation").is_file()
        payload = (
            b"not a sqlite database\n"
            if corrupt
            else b"SQLite format 3\x00" + f"fake conversation {conversation_id}\n".encode()
        )
        path.write_bytes(payload)
        os.chmod(path, 0o600)
    except Exception:
        pass


def _write_env_probe() -> None:
    """Record HOME/DBUS when the test opts in, proving the child env isolation."""
    home = os.environ.get("HOME")
    if not home:
        return
    if not (Path(home) / ".fake_agy_env_probe").is_file():
        return
    try:
        (Path(home) / "env-probe.json").write_text(
            json.dumps(
                {
                    "HOME": home,
                    "DBUS_SESSION_BUS_ADDRESS": os.environ.get("DBUS_SESSION_BUS_ADDRESS"),
                }
            ),
            encoding="utf-8",
        )
    except Exception:
        pass


def _fake_usage_email() -> str:
