        }
        print(json.dumps(output))
        sys.exit(0)

    elif scenario == "env_probe":
        log_entry(log_file, "Dumping environment variables to env_dump.json")
        out_dir = Path(os.environ.get("TMPDIR", "."))
        dump_file = out_dir / "env_dump.json"
        dump_file.write_text(json.dumps(dict(os.environ), indent=2))
        output = {
            "conversation_id": conversation_id,
            "status": "SUCCESS",
            "response": "Environment dumped successfully.",
            "usage": {"input_tokens": 50, "output_tokens": 20, "total_tokens": 70},
        }
        print(json.dumps(output))
        sys.exit(0)

    elif scenario == "stdin_probe":
        log_entry(log_file, "Probing stdin descriptor")
        # Check if stdin is non-blocking or at EOF
        has_input = False
        try:
            rlist, _, _ = select.select([sys.stdin], [], [], 0.1)
            if rlist:
                content = sys.stdin.read(1024)
                has_input = len(content) > 0
        except Exception:
            has_input = False

        Path("stdin_probe.txt").write_text(f"has_input={has_input}\n")
        output = {
            "conversation_id": conversation_id,
            "status": "SUCCESS",
            "response": f"Stdin checked, has_input={has_input}",
            "usage": {"input_tokens": 50, "output_tokens": 20, "total_tokens": 70},
        }
        print(json.dumps(output))
        sys.exit(0)

    else:
        log_entry(log_file, f"Unknown scenario: {scenario}")
        sys.stderr.write(f"Error: unknown simulation scenario {scenario}\n")
        sys.exit(1)


