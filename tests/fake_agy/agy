            sys.stderr.write(f"malicious_hostwrite failed: {exc}\n")
            sys.exit(3)
        output = {
            "conversation_id": conversation_id,
            "status": "SUCCESS",
            "response": "Tampered with host file.",
        }
        print(json.dumps(output))
        sys.exit(0)

    elif scenario == "known_hosts_append":
        log_entry(log_file, "Scenario: appending to ~/.ssh/known_hosts")
        home = Path(os.environ.get("HOME", "/tmp"))
        ssh_dir = home / ".ssh"
        ssh_dir.mkdir(parents=True, exist_ok=True)
        target = ssh_dir / "known_hosts"
        try:
            with open(target, "a", encoding="utf-8") as f:
                f.write("example.com ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKey\n")
        except Exception:
            pass
        (Path.cwd() / "output.txt").write_text("work done\n", encoding="utf-8")
        dot_agy = Path.cwd() / ".agy"
        dot_agy.mkdir(parents=True, exist_ok=True)
        (dot_agy / "COMMIT_MSG").write_text(
            "Feature: work done\n\nCompleted task.", encoding="utf-8"
        )
        output = {
            "conversation_id": conversation_id,
            "status": "SUCCESS",
            "response": "Appended to known_hosts and committed work.",
            "usage": {
                "input_tokens": 100,
                "output_tokens": 50,
                "total_tokens": 150,
            },
        }
        print(json.dumps(output))
        sys.exit(0)

    elif scenario == "slow_progress":
        log_entry(log_file, "Simulating multi-stage slow execution")
        time.sleep(0.6)
        Path("slow_stage1.txt").write_text("Stage 1 done\n")
        agy_dir = Path(".agy")
        agy_dir.mkdir(parents=True, exist_ok=True)
        (agy_dir / "COMMIT_MSG").write_text("Complete stage 1\n\nStage 1 details.")
        time.sleep(0.4)
        output = {
            "conversation_id": conversation_id,
            "status": "SUCCESS",
            "response": "Finished slow progress tasks.",
            "usage": {"input_tokens": 300, "output_tokens": 100, "total_tokens": 400},
        }
        print(json.dumps(output))
        sys.exit(0)

    elif scenario == "resume_echo":
        log_entry(log_file, f"Resuming session with conversation: {conversation_id}")
        output = {
            "conversation_id": conversation_id,
            "status": "SUCCESS",
            "response": f"Resumed conversation {conversation_id} with prompt: {prompt}",
